# Copy to .env and fill in the three passwords from instructions.pdf.
# .env is gitignored. Values here only matter for `--target demo`; the simulator ignores them.

# --- Network (instructions.pdf, page 2). Drop Copy shares the Order Entry port. ---
EXI_PRIMARY_HOST=206.109.100.83
EXI_MD_PORT=13001
EXI_OE_PORT=13101
EXI_TARGET_COMP_ID=EXI
EXI_HEARTBEAT_S=30

# --- Sessions (Logon carries Password(554) and DefaultApplVerID(1137)=9) ---
EXI_MD_SENDER=HURON-MD01
EXI_MD_PASSWORD=
EXI_OE_SENDER=D-HURON-01-OE01
EXI_OE_PASSWORD=
EXI_DC_SENDER=CM-HURON-DC01
EXI_DC_PASSWORD=

# --- Mutual TLS, done natively in Python ---
EXI_CA_CERT=ca.crt
EXI_CLIENT_CERT=client.crt
EXI_CLIENT_KEY=client.key
# Leave blank to verify the chain against ca.crt without hostname matching (we connect by IP).
EXI_TLS_SERVER_NAME=
# To go through stunnel instead (see "Sample Stunnel Configuration"), set:
# EXI_USE_TLS=N
# EXI_HOST=127.0.0.1

# --- Required order tags (instructions.pdf, page 3) ---
EXI_ACCOUNT=TA-HURON-00001
EXI_TRADER=jheng@greenwichcm.com
EXI_CAPACITY=2

# --- Instruments: comma-separated symbols, e.g. BFUT500-ERCOT-HB_NORTH-261022-15 ---
# List what is tradable with: python -m exoms instruments --target demo
EXI_SYMBOLS=
# Fallback only; each instrument's MinPriceIncrement(969) from SecurityList is used when known.
EXI_TICK_SIZE=0.25

# --- Throttle: the exchange limit is 100 msg/sec on D-HURON-01-OE01 ---
EXI_RATE_LIMIT=100
EXI_RATE_SAFETY=0.9
EXI_CANCEL_RESERVE=0.25

# --- Pre-trade risk ---
EXI_MAX_ORDER_QTY=5
EXI_MAX_POSITION=10
EXI_MAX_OPEN_ORDERS=4
EXI_MIN_PRICE=0.01
EXI_MAX_PRICE=1000
EXI_PRICE_BAND=0.05

# --- Demo quoting strategy ---
EXI_QUOTE_QTY=1
EXI_HALF_SPREAD_TICKS=2
EXI_REQUOTE_TICKS=1
EXI_SKEW_TICKS_PER_LOT=0.5
